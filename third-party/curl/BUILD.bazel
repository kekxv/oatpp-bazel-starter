load("@rules_foreign_cc//foreign_cc:defs.bzl", "cmake")

exports_files([
    "repositories.MODULE.bazel",
])

_CACHE_ENTRIES = dict({
    "BUILD_SHARED_LIBS": "OFF",
    "BUILD_STATIC_LIBS": "ON",
    "CMAKE_BUILD_TYPE": "RELEASE",
    "BUILD_EXAMPLES": "OFF",
    "BUILD_TESTING": "OFF",
    "CURL_ENABLE_SSL": "ON",
    "CURL_USE_OPENSSL": "ON",
    "BUILD_CURL_EXE": "OFF",
    "CMAKE_PREFIX_PATH": "$$EXT_BUILD_DEPS$$/openssl;$$EXT_BUILD_DEPS$$/zlib",
})

cmake(
    name = "curl-build",
    build_args = ["-j2"],
    cache_entries = select({
        "@platforms//os:osx": dict(_CACHE_ENTRIES.items() + {
            "USE_NGHTTP2": "OFF",
            "USE_LIBIDN2": "OFF",
            "USE_APPLE_IDN": "OFF",
            "CMAKE_SYSTEM_NAME": "Darwin",
            "CMAKE_C_FLAGS": "$${CMAKE_C_FLAGS:-} -DHAVE_STRUCT_TIMEVAL",
            "CMAKE_CXX_FLAGS": "$${CMAKE_CXX_FLAGS:-} -DHAVE_STRUCT_TIMEVAL",
        }.items()),
        "//conditions:default": _CACHE_ENTRIES,
    }),
    generate_crosstool_file = False,
    lib_source = "@curl//:all",
    linkopts = select({
        "@platforms//os:osx": [
            "-llber",
            "-lldap",
        ],
        "//conditions:default": [
            "-std=c++11",
            "-ldl",
            "-fPIC",
        ],
    }),
    out_static_libs = select({
        "@platforms//os:windows": [
            "libcurl.lib",
        ],
        "//conditions:default": [
            "libcurl.a",
        ],
    }),
    deps = select({
        "//conditions:default": [
            "//third-party/zlib",
            "@boringssl//:crypto",
            "@boringssl//:ssl",
        ],
    }),
)

cc_library(
    name = "curl",
    linkopts = select({
        "@platforms//os:osx": [
            "-framework SystemConfiguration",
        ],
        "//conditions:default": [],
    }),
    visibility = ["//visibility:public"],
    deps = [":curl-build"],
)

cc_binary(
    name = "curl_test",
    srcs = ["test.cpp"],
    deps = [":curl"],
)
